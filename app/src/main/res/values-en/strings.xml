    <string name="privacidad_solo_telefono">Only on my phone</string>
    <string name="privacidad_necesita_t">This needs the cloud</string>
    <string name="privacidad_necesita">To read what you show me, the photo is sent to Google (Gemini). The cloud is off right now. Do you want to turn it on?</string>
